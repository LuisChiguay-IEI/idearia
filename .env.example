# ===============================================================
# Idearia - plantilla de variables de entorno
# Copia este archivo como .env y reemplaza los valores.
# El archivo .env NO se sube a Git (está en .gitignore).
# ===============================================================

# --- Django -----------------------------------------------------
# Genera una clave con:
# .\.venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="reemplaza-esta-clave-por-una-generada"
DEBUG="True"
ALLOWED_HOSTS="127.0.0.1,localhost"
# Solo en producción (ej.: https://idearia.midominio.cl)
CSRF_TRUSTED_ORIGINS=""

# --- Base de datos ----------------------------------------------
# DB_ENGINE="sqlite"   -> base local db.sqlite3 (desarrollo sin internet)
# DB_ENGINE="supabase" -> PostgreSQL en Supabase (entrega final)
DB_ENGINE="sqlite"

# Datos de Supabase: Connect > Connection string > Session pooler
DB_HOST="aws-0-REGION.pooler.supabase.com"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres.ID_DEL_PROYECTO"
DB_PASSWORD="TU_CONTRASENA_DE_BD"
# Supabase exige SSL. Usa "disable" solo para un PostgreSQL local de pruebas.
DB_SSLMODE="require"
# Segundos que se reutiliza una conexión: 0 en desarrollo (runserver), 60 en producción
DB_CONN_MAX_AGE="0"

# --- Archivos ---------------------------------------------------
TAMANO_MAXIMO_ARCHIVO_MB="10"

# --- Datos de demostración (comando cargar_demo) ---------------
# Contraseña que tendrán los usuarios de demostración (mínimo 10 caracteres).
DEMO_PASSWORD=""

# --- Producción (HTTPS) -----------------------------------------
# Con DEBUG="False" se activan cookies seguras, HSTS y redirección a HTTPS.
SECURE_SSL_REDIRECT="True"
SECURE_HSTS_SECONDS="31536000"
# Solo con un dominio propio definitivo (inscribe el sitio en la lista HSTS de los navegadores)
SECURE_HSTS_PRELOAD="False"
# "True" si el servidor está detrás de un proxy que termina HTTPS (Render, Railway, Nginx)
USAR_PROXY_HTTPS="False"
# Ruta del admin técnico de Django (cámbiala para no usar la ruta por defecto)
ADMIN_URL="admin-django/"
